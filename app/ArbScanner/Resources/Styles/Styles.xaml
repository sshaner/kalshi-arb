<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Background">#0B1220</Color>
    <Color x:Key="Surface">#131C2E</Color>
    <Color x:Key="SurfaceAlt">#1B2740</Color>
    <Color x:Key="Border">#26344F</Color>
    <Color x:Key="Text">#E8EEF8</Color>
    <Color x:Key="MutedColor">#8A99B4</Color>
    <Color x:Key="Accent">#4FD1A5</Color>
    <Color x:Key="Kalshi">#3BA3FF</Color>
    <Color x:Key="Pmus">#A78BFA</Color>
    <Color x:Key="Danger">#FF6B6B</Color>
    <Color x:Key="Warn">#F5B94A</Color>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Error" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="#06281C" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#3A1E26" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Accent}" />
    </Style>
</ResourceDictionary>

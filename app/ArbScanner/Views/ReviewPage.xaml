<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArbScanner.ViewModels"
             xmlns:controls="clr-namespace:ArbScanner.Controls"
             xmlns:services="clr-namespace:ArbScanner.Services"
             xmlns:m="clr-namespace:ArbScanner.Models;assembly=ArbScanner.Core"
             x:Class="ArbScanner.Views.ReviewPage"
             x:DataType="vm:ReviewViewModel"
             Title="Review pairs">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding ToggleText, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}"
                     Command="{Binding ToggleCommand, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}" />
        <ToolbarItem Text="Pairs" Command="{Binding PairsCommand}" />
        <ToolbarItem Text="Rescan" Command="{Binding DiscoverCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16,4,16,0" RowSpacing="6">
        <controls:HelpCard ScreenKey="review" />

        <SearchBar Grid.Row="1" Text="{Binding SearchText}" Placeholder="Search team, player or topic"
                   TextColor="{StaticResource Text}" PlaceholderColor="{StaticResource MutedColor}" />

        <!-- Quick filters + full filter sheet -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <Button Text="{Binding QuickTopText}" Command="{Binding ToggleTopCommand}" Padding="12,6" FontSize="13" />
                <Button Text="{Binding QuickGapText}" Command="{Binding ToggleGapCommand}" Padding="12,6" FontSize="13" />
                <Button Text="{Binding QuickSoonText}" Command="{Binding ToggleSoonCommand}" Padding="12,6" FontSize="13" />
                <Button Text="{Binding FiltersButtonText}" Command="{Binding OpenFiltersCommand}" Padding="12,6" FontSize="13"
                        Style="{StaticResource Primary}" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <Label Text="{Binding ShowingText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <controls:InfoButton Grid.Column="1" Term="deal-rating" />
        </Grid>
        <Label Grid.Row="4" Text="{Binding Error}" Style="{StaticResource Error}" />

        <RefreshView Grid.Row="5" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                            RemainingItemsThreshold="8" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <Label Text="Nothing matches these filters. Loosen them, clear the search, or tap Rescan."
                           Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Candidate">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:RatingBadge Rating="{Binding Rating}" RatingText="{Binding RatingLabel}" />
                                    <Label Grid.Column="1" Text="{Binding GapDisplay}" Style="{StaticResource Muted}"
                                           VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding ScoreDisplay}" Style="{StaticResource Muted}"
                                           VerticalOptions="Center" Margin="8,0,0,0" />
                                </Grid>
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding IsOn, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}">
                                    <Label Text="{Binding Suggestion}" TextColor="{StaticResource Accent}" FontAttributes="Bold" />
                                    <Label Text="{Binding Explanation.Summary}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="KALSHI" FontSize="11" TextColor="{StaticResource Kalshi}" FontAttributes="Bold" />
                                    <Label Text="{Binding Kalshi.Display}" />
                                    <Label Text="{Binding Kalshi.Quote}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding Kalshi.CloseDisplay, StringFormat='closes {0}'}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="POLYMARKET US" FontSize="11" TextColor="{StaticResource Pmus}" FontAttributes="Bold" />
                                    <Label Text="{Binding Pmus.Display}" />
                                    <Label Text="{Binding Pmus.Quote}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding Pmus.CloseDisplay, StringFormat='closes {0}'}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Button Text="Explain this pair"
                                        IsVisible="{Binding IsOn, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}"
                                        Command="{Binding ExplainCommand, Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, x:DataType=vm:ReviewViewModel}"
                                        CommandParameter="{Binding .}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Button Text="Same" Style="{StaticResource Primary}" Padding="4,8"
                                            Command="{Binding ApproveCommand, Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, x:DataType=vm:ReviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1" Text="Inverse" Padding="4,8"
                                            Command="{Binding ApproveInvertedCommand, Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, x:DataType=vm:ReviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2" Text="Rules" Padding="4,8"
                                            Command="{Binding RulesCommand, Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, x:DataType=vm:ReviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3" Text="Reject" Style="{StaticResource DangerButton}" Padding="4,8"
                                            Command="{Binding RejectCommand, Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, x:DataType=vm:ReviewViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

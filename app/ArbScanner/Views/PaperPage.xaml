<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArbScanner.ViewModels"
             xmlns:controls="clr-namespace:ArbScanner.Controls"
             xmlns:services="clr-namespace:ArbScanner.Services"
             xmlns:m="clr-namespace:ArbScanner.Models;assembly=ArbScanner.Core"
             x:Class="ArbScanner.Views.PaperPage"
             x:DataType="vm:PaperViewModel"
             Title="Paper trading">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding ToggleText, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}"
                     Command="{Binding ToggleCommand, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <controls:HelpCard ScreenKey="paper" />
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout>
                    <Label Text="Realized P&amp;L" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <controls:InfoButton Term="paper" />
                </HorizontalStackLayout>
                <Label Text="{Binding Headline}" Style="{StaticResource H1}" TextColor="{StaticResource Accent}" />
                <Label Text="{Binding Subline}" Style="{StaticResource Muted}" />
                <Label Text="{Binding DivergentLine}" TextColor="{StaticResource Warn}" />
                <controls:HintLabel Text="Divergent = the exchanges disagreed and the hedge failed. Zero over many settled positions is the goal." />
            </VerticalStackLayout>
        </Border>
        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Label Text="Open positions" VerticalOptions="Center" Style="{StaticResource Muted}" />
            <Switch IsToggled="{Binding ShowOpen}" />
        </HorizontalStackLayout>
        <Label Grid.Row="3" Text="{Binding Error}" Style="{StaticResource Error}" />
        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No positions yet." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PaperPosition">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExplainCommand, Source={RelativeSource AncestorType={x:Type vm:PaperViewModel}}, x:DataType=vm:PaperViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                <Label Text="{Binding Detail}" />
                                <Label Text="{Binding Opened, StringFormat='opened {0}'}" Style="{StaticResource Muted}" />
                                <controls:HintLabel Text="{Binding Explanation.Summary, StringFormat='{0} Tap to see why.'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

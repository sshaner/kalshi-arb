<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArbScanner.ViewModels"
             xmlns:m="clr-namespace:ArbScanner.Models;assembly=ArbScanner.Core"
             xmlns:controls="clr-namespace:ArbScanner.Controls"
             xmlns:services="clr-namespace:ArbScanner.Services"
             x:Class="ArbScanner.Views.OpportunitiesPage"
             x:DataType="vm:OpportunitiesViewModel"
             Title="Opportunities">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding ToggleText, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}"
                     Command="{Binding ToggleCommand, Source={x:Static services:LearningMode.Current}, x:DataType=services:LearningMode}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <controls:HelpCard ScreenKey="opportunities" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Label Text="Live only" VerticalOptions="Center" Style="{StaticResource Muted}" />
            <Switch Grid.Column="1" IsToggled="{Binding ShowActive}" />
            <Picker Grid.Column="2" Title="Sort" ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex}"
                    TextColor="{StaticResource Text}" BackgroundColor="{StaticResource SurfaceAlt}" />
            <controls:InfoButton Grid.Column="3" Term="best-return" />
        </Grid>
        <Label Grid.Row="2" Text="{Binding Error}" Style="{StaticResource Error}" />
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No opportunities right now. Approve more pairs in Review to widen the net."
                           Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Opportunity">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:OpportunitiesViewModel}}, x:DataType=vm:OpportunitiesViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                                <controls:RatingBadge Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                                      Rating="{Binding Rating}" RatingText="{Binding RatingLabel}" />
                                <Label Text="{Binding Title}" Style="{StaticResource H2}" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Grid.Column="1" Text="{Binding EdgeDisplay}" Style="{StaticResource H2}" TextColor="{StaticResource Accent}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Legs}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="2" Text="{Binding ProfitDisplay}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReturnDisplay}" TextColor="{StaticResource Accent}" />
                                <controls:HintLabel Grid.Row="3" Grid.ColumnSpan="2"
                                                    Text="{Binding Explanation.Summary, StringFormat='{0} Tap for the step-by-step walkthrough.'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

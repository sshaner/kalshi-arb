<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS is the shipping target. Android is listed only so the shared C#/XAML can be
         compile-checked on Windows (iOS builds need the macOS GitHub runner). -->
    <TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>ArbScanner</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Arb Scanner</ApplicationTitle>
    <ApplicationId>org.shnr.arbscanner</ApplicationId>

    <!-- ApplicationVersion (CFBundleVersion) is overridden per CI run from github.run_number -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1220" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1220" BaseSize="160,160" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
